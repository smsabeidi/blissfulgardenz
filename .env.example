# The Inner Garden — paste these into .env.local (and into Vercel project settings).
# The site runs WITHOUT these: the member area simply stays closed and the
# marketing site is unaffected. Fill them in and the platform comes alive.

# ── Supabase (auth + database) ────────────────────────────────────────────
# supabase.com → New project → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase auth config push (LOCAL ONLY, never deployed) ────────────────
# These two are read by `supabase config push` from supabase/config.toml. They
# are NOT read by the app and do not belong in Vercel. Keep them somewhere you
# run the CLI from, and nowhere else.
#
# ⚠️ They must BOTH be present when you push. `config push` sends the whole auth
# config, so an empty secret here would disable live Google sign-in.
#
# Supabase → Authentication → Sign In / Providers → Google
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ── Stripe (billing) ──────────────────────────────────────────────────────
# dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=
# Developers → Webhooks → add endpoint /api/stripe/webhook → signing secret
STRIPE_WEBHOOK_SECRET=
# Products → create "Bloom" → copy the PRICE ids (price_...), not product ids
STRIPE_PRICE_BLOOM_MONTHLY=
STRIPE_PRICE_BLOOM_ANNUAL=
# Founding-cohort price (optional; falls back to the annual price above)
STRIPE_PRICE_BLOOM_FOUNDING_ANNUAL=

# ── Resend (email: login codes + letters) ─────────────────────────────────
# resend.com → API keys. Verify TWO subdomains, see docs in README.
RESEND_API_KEY=
EMAIL_FROM_TRANSACTIONAL="Blissful Gardenz <hello@mail.blissfulgardenz.com>"
EMAIL_FROM_LETTERS="Dr. Laiyemo <letters@news.blissfulgardenz.com>"
# Where contact-form and founding-list notifications land
EMAIL_TO_TEAM=

# ── Mux (member video) ────────────────────────────────────────────────────
# mux.com → Settings → Access Tokens (needs Mux Video read)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Settings → Signing Keys (for signed playback). Base64 private key.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=

# ── Booking ───────────────────────────────────────────────────────────────
# Your Cal.com public booking link, e.g. https://cal.com/laiyemo/conversation
NEXT_PUBLIC_CAL_BOOKING_URL=

# ── Site ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Cron ──────────────────────────────────────────────────────────────────
# Any long random string. Protects /api/cron/reconcile, which repairs
# entitlement drift nightly. Set the SAME value in Vercel project settings.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=
